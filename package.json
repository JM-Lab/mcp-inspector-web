{
  "name": "mcp-inspector-web",
  "version": "0.1.0",
  "description": "An MCP Inspector that runs entirely in the browser. Connect to a remote MCP server, run its tools, prompts and resources, and read every message.",
  "license": "MIT",
  "author": "Jemin Huh",
  "homepage": "https://aljal.kr/miw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JM-Lab/mcp-inspector-web.git"
  },
  "bugs": {
    "url": "https://github.com/JM-Lab/mcp-inspector-web/issues"
  },
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-inspector",
    "mcp-client",
    "mcp-registry",
    "browser"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./auto": "./src/auto.js",
    "./add-to-ai": {
      "types": "./src/add-to-ai.d.ts",
      "default": "./src/add-to-ai.js"
    },
    "./debug": {
      "types": "./src/debug.d.ts",
      "default": "./src/debug.js"
    },
    "./lib": {
      "types": "./src/lib.d.ts",
      "default": "./src/lib.js"
    },
    "./conn": "./src/conn.js",
    "./style.css": "./src/style.css",
    "./dist/*": "./dist/*"
  },
  "types": "src/index.d.ts",
  "unpkg": "dist/mcp-inspector.js",
  "jsdelivr": "dist/mcp-inspector.js",
  "bin": {
    "mcp-inspector-web": "bin/mcp-inspector-web.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "demo/featured.json",
    "scripts/featured.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "demo": "node scripts/build.js && node scripts/serve.js",
    "featured": "node scripts/featured.js --out demo/featured.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "npx -y -p typescript@5 tsc --noEmit --strict --skipLibCheck src/index.d.ts src/add-to-ai.d.ts src/lib.d.ts src/debug.d.ts",
    "prepublishOnly": "npm test && npm run typecheck && npm run build",
    "prepare": "npm run build",
    "version": "node scripts/version.js && git add src/conn.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "esbuild": "^0.27.7",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
